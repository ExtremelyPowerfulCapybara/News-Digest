# ── NewsAPI ───────────────────────────────────────────────────────────────
NEWS_API_KEY=

# ── Anthropic Claude ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Email delivery ───────────────────────────────────────────────────────
EMAIL_SENDER=                # Gmail address used to send
EMAIL_PASSWORD=              # Gmail App Password (not your account password)
SUBSCRIBERS=                 # Comma-separated: you@gmail.com,other@example.com

# ── Telegram editorial bot ───────────────────────────────────────────────
TELEGRAM_TOKEN=              # botXXXXXX:ABCDEF...
TELEGRAM_CHAT_ID=            # Group/channel chat ID (usually a negative number)

# ── Site publishing ───────────────────────────────────────────────────────
# Leave PUBLISH_WEB_ROOT empty — nginx serves directly from the docs/ volume
PUBLISH_WEB_ROOT=
PUBLIC_ARCHIVE_BASE_URL=https://newsletter.mustardhq.dev

# ── OpenAI (image generation) ────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2   # gpt-image-1 retires Oct 23 2026
                                  # Requires Organization Verification on your OpenAI account

# ── Pipeline flags ────────────────────────────────────────────────────────
SKIP_EMAIL=false             # true = render archive only, skip SMTP
FORCE_RUN=false              # true = bypass duplicate-run guard
MOCK=false                   # true = skip NewsAPI + Anthropic, use saved digest
SKIP_IMAGE=false             # true = skip OpenAI image generation entirely
